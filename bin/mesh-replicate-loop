#!/usr/bin/env bash
set -euo pipefail

LOCAL_BRAIN_DIR="/home/akujin/Sources/Navi-Brain"
INTERVAL=300  # 5 minutes

echo "[mesh-replicate] Starting replication loop every ${INTERVAL}s..."
while true; do
    echo "[mesh-replicate] $(date -Iseconds) Replicating..."
    cd "$LOCAL_BRAIN_DIR"
    bash bin/replicate 2>&1 || echo "[mesh-replicate] Error, retrying in ${INTERVAL}s"
    sleep "$INTERVAL"
done
