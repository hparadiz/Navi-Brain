#!/usr/bin/env php
<?php

declare(strict_types=1);

const SOCKET_PATH = '/run/navi-senses/navi-senses.sock';
const OBSERVATION_PROTOCOL = 'navi-observation-v1';
const MAX_OUTPUT_BYTES = 16384;
const MAX_REQUEST_BYTES = 8192;

$running = true;
if (function_exists('pcntl_async_signals') && function_exists('pcntl_signal')) {
    pcntl_async_signals(true);
    pcntl_signal(SIGTERM, static function () use (&$running): void { $running = false; });
    pcntl_signal(SIGINT, static function () use (&$running): void { $running = false; });
}

function logLine(array $record): void
{
    $record['at'] = time();
    fwrite(STDOUT, json_encode( $record, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR ) . PHP_EOL);
    fflush(STDOUT);
}

if (!function_exists('posix_geteuid') || !function_exists('posix_getpwuid')) {
    fwrite(STDERR, "navi-senses requires POSIX account identity checks\n");
    exit(1);
}
$self = posix_getpwuid(posix_geteuid())['name'] ?? '';
if (posix_geteuid() === 0 || $self !== 'navi-senses') {
    fwrite(STDERR, "navi-senses must run as the navi-senses account\n");
    exit(1);
}

@mkdir(dirname(SOCKET_PATH), 0750, true);
if (file_exists(SOCKET_PATH)) {
    @unlink(SOCKET_PATH);
}

$errorNumber = 0;
$errorMessage = '';
$server = @stream_socket_server('unix://' . SOCKET_PATH, $errorNumber, $errorMessage);
if (!is_resource($server)) {
    fwrite(STDERR, sprintf("cannot listen on %s: %s (%d)\n", SOCKET_PATH, $errorMessage, $errorNumber));
    exit(1);
}

@chmod(SOCKET_PATH, 0660);
logLine([ 'listening' => SOCKET_PATH, 'user' => $self, 'readable_by' => 'group users', ]);

/** @return array<string, list<string>> */
function observationFiles(): array
{

    return [
        'system.summary' => ['/proc/uptime', '/proc/loadavg', '/proc/meminfo', '/proc/version'],
        'system.uptime' => ['/proc/uptime'],
        'system.load' => ['/proc/loadavg'],
        'system.memory' => ['/proc/meminfo'],
        'system.cpu' => ['/proc/cpuinfo'],
        'system.kernel' => ['/proc/version'],
    ];
}

/** @return array<string, mixed> */
function look(mixed $request): array
{
    $operation = is_array($request) && is_string($request['operation'] ?? null)
        ? $request['operation']
        : '';
    $result = [
        'protocol' => OBSERVATION_PROTOCOL,
        'operation' => $operation,
        'effect_contract' => 'fixed_kernel_files_v1',
        'ran' => false,
        'refused' => true,
        'exit_code' => null,
        'timed_out' => false,
        'seconds' => 0.0,
        'output' => '',
        'error_output' => '',
        'output_digest' => hash('sha256', ''),
        'output_bytes' => 0,
        'truncated' => false,
    ];
    $catalog = observationFiles();
    if (!is_array($request)
        || ($request['protocol'] ?? null) !== OBSERVATION_PROTOCOL
        || count($request) !== 2
        || !isset($catalog[$operation])
    ) {
        $result['refused_because'] = 'Unsupported observation request. Use protocol '
            . OBSERVATION_PROTOCOL . ' and one named operation: ' . implode(', ', array_keys($catalog))
            . '. Commands, caller-selected paths and shell syntax are not supported.';
        return $result;
    }

    $started = microtime(true);
    $output = '';
    foreach ($catalog[$operation] as $path) {
        $remaining = MAX_OUTPUT_BYTES - strlen($output);
        if ($remaining <= 0) {
            $result['truncated'] = true;
            break;
        }

        $content = @file_get_contents($path, false, null, 0, $remaining + 1);
        if ($content === false) {
            $result['refused_because'] = 'Required kernel observation file is unavailable: ' . $path;
            return $result;
        }
        $chunk = count($catalog[$operation]) > 1 ? $path . ":\n" . $content . "\n" : $content;
        $result['truncated'] = $result['truncated'] || strlen($chunk) > $remaining;
        $output .= substr($chunk, 0, $remaining);
    }

    return array_merge($result, [
        'ran' => true,
        'refused' => false,
        'exit_code' => 0,
        'seconds' => round(microtime(true) - $started, 2),
        'output' => $output,
        'output_digest' => hash('sha256', $output),
        'output_bytes' => strlen($output),
    ]);
}

while ($running) {
    $client = @stream_socket_accept($server, 1);
    if (!is_resource($client)) {
        continue;
    }
    stream_set_timeout($client, 5);
    $request = (string) fgets($client, MAX_REQUEST_BYTES);
    $decoded = json_decode(trim($request), true);
    $result = look($decoded);
    logLine([
        'operation' => mb_substr((string) ($result['operation'] ?? ''), 0, 200),
        'exit_code' => $result['exit_code'] ?? null,
        'refused' => $result['refused'],
        'bytes' => $result['output_bytes'] ?? 0,
    ]);

    @fwrite($client, json_encode( $result, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE ) . "\n");
    @fclose($client);
}

fclose($server);
@unlink(SOCKET_PATH);
logLine(['stopped' => true]);
