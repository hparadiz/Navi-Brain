#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * The looking service.
 *
 * Runs as its own unprivileged account and listens on a unix socket. Navi-Brain
 * connects and asks it to look at something; it runs the command, bounds the
 * result, and hands back what it saw. The brain itself never executes anything.
 *
 * The separation is the design. "Only read" is not a rule this process obeys,
 * it is a fact about the account it runs as: no group membership, no write
 * permission outside its own runtime directory, no login. A pattern list has to
 * anticipate every spelling of a destructive command; a process that lacks the
 * permission simply fails. Adding a capability later is a change to one
 * account rather than an edit to a regular expression.
 *
 * The socket, not sudo, is the privilege boundary, so nothing here elevates and
 * there is no path by which it could. Whoever can reach the socket gets exactly
 * this account's authority and no more.
 */

const SOCKET_PATH = '/run/navi-senses/navi-senses.sock';
const TIMEOUT_SECONDS = 8;
const MAX_OUTPUT_BYTES = 16384;
const MAX_REQUEST_BYTES = 8192;

/**
 * Limits permissions cannot express. A read-only account can still fork until
 * the machine stops or fill a world-writable directory, and neither is
 * destruction so much as denial of everything else.
 */
const LIMITS = 'ulimit -t 10 -u 96 -v 1048576 -f 4096 2>/dev/null;';

$running = true;
if (function_exists('pcntl_async_signals') && function_exists('pcntl_signal')) {
    pcntl_async_signals(true);
    pcntl_signal(SIGTERM, static function () use (&$running): void { $running = false; });
    pcntl_signal(SIGINT, static function () use (&$running): void { $running = false; });
}

function logLine(array $record): void
{
    $record['at'] = time();
    fwrite(STDOUT, json_encode(
        $record,
        JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR
    ) . PHP_EOL);
    fflush(STDOUT);
}

/**
 * Refuse to run as the account that owns the machine.
 *
 * If the service is started wrong it would hold full write access to the home
 * directory, and every "look" would silently become able to destroy. That is
 * the one misconfiguration whose failure mode is invisible, so it is checked
 * rather than assumed.
 */
if (function_exists('posix_geteuid') && posix_geteuid() === 0) {
    fwrite(STDERR, "navi-senses must not run as root\n");
    exit(1);
}
$self = function_exists('posix_getpwuid') && function_exists('posix_geteuid')
    ? (posix_getpwuid(posix_geteuid())['name'] ?? '')
    : '';
if ($self !== '' && $self !== 'navi-senses') {
    fwrite(STDERR, sprintf(
        "navi-senses must run as the navi-senses account, not %s; refusing so that looking cannot become writing\n",
        $self
    ));
    exit(1);
}

@mkdir(dirname(SOCKET_PATH), 0750, true);
if (file_exists(SOCKET_PATH)) {
    @unlink(SOCKET_PATH);
}

$errorNumber = 0;
$errorMessage = '';
$server = @stream_socket_server(
    'unix://' . SOCKET_PATH,
    $errorNumber,
    $errorMessage
);
if (!is_resource($server)) {
    fwrite(STDERR, sprintf("cannot listen on %s: %s (%d)\n", SOCKET_PATH, $errorMessage, $errorNumber));
    exit(1);
}
// The socket inherits the process's primary group, which the service file sets
// to `users`. That is what admits the brain and nothing else: akujin is in
// `users`, anyone else on the machine is not offered this account's reach.
// chgrp is not attempted, because a process cannot give a file away to a group
// it does not belong to and the silent failure would look like a permissions
// bug much later.
@chmod(SOCKET_PATH, 0660);
logLine([
    'listening' => SOCKET_PATH,
    'user' => $self,
    'readable_by' => 'group users',
]);

/** @return array<string, mixed> */
function look(string $command): array
{
    $command = trim($command);
    if ($command === '') {
        return ['ran' => false, 'refused' => true, 'refused_because' => 'an empty command'];
    }

    $pipes = [];
    // A shell on purpose: pipes and globs are most of what makes looking
    // around useful, and this account cannot do damage with them.
    $process = @proc_open(
        ['/bin/sh', '-c', LIMITS . ' ' . $command],
        [0 => ['file', '/dev/null', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']],
        $pipes
    );
    if (!is_resource($process)) {
        return ['ran' => false, 'refused' => true, 'refused_because' => 'a shell that would not start'];
    }

    stream_set_blocking($pipes[1], false);
    stream_set_blocking($pipes[2], false);
    $stdout = '';
    $stderr = '';
    $started = microtime(true);
    $timedOut = false;

    while (true) {
        $stdout .= (string) stream_get_contents($pipes[1]);
        $stderr .= (string) stream_get_contents($pipes[2]);
        if (strlen($stdout) + strlen($stderr) > MAX_OUTPUT_BYTES) {
            proc_terminate($process, 9);
            $stdout = substr($stdout, 0, MAX_OUTPUT_BYTES);
            break;
        }
        $status = proc_get_status($process);
        if (!($status['running'] ?? false)) {
            break;
        }
        if (microtime(true) - $started > TIMEOUT_SECONDS) {
            proc_terminate($process, 9);
            $timedOut = true;
            break;
        }
        usleep(20000);
    }

    $stdout .= (string) stream_get_contents($pipes[1]);
    $stderr .= (string) stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    $exit = proc_close($process);

    return [
        'ran' => true,
        'refused' => false,
        'exit_code' => $timedOut ? 124 : $exit,
        'timed_out' => $timedOut,
        'seconds' => round(microtime(true) - $started, 2),
        'output' => mb_substr(trim($stdout), 0, 2000),
        'error_output' => mb_substr(trim($stderr), 0, 500),
        // The digest is what lets the cortex tell a changed result from a
        // repeated one without carrying the whole output as a reading.
        'output_digest' => hash('sha256', $stdout),
        'output_bytes' => strlen($stdout),
    ];
}

while ($running) {
    $client = @stream_socket_accept($server, 1);
    if (!is_resource($client)) {
        continue;
    }
    stream_set_timeout($client, 5);
    $request = (string) fgets($client, MAX_REQUEST_BYTES);
    $decoded = json_decode(trim($request), true);
    $command = is_array($decoded) ? (string) ($decoded['command'] ?? '') : '';

    $result = look($command);
    $result['command'] = $command;
    logLine([
        'command' => mb_substr($command, 0, 200),
        'exit_code' => $result['exit_code'] ?? null,
        'refused' => $result['refused'],
        'bytes' => $result['output_bytes'] ?? 0,
    ]);

    @fwrite($client, json_encode(
        $result,
        JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE
    ) . "\n");
    @fclose($client);
}

fclose($server);
@unlink(SOCKET_PATH);
logLine(['stopped' => true]);
