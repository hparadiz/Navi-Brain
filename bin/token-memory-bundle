os.umask(0o077)


FORMAT_VERSION = "NAVITOKBACKUP1"
MANIFEST_NAME = "MANIFEST.sha256"
FORMAT_NAME = "FORMAT"
APPLICATION_NAME = "application.sqlite3"
TOKEN_STORE_NAME = "token-store"
SAFE_TIER = re.compile(r"[A-Za-z0-9_.-]{1,100}\Z")
SAFE_ID = re.compile(r"[1-9][0-9]*\Z")
SHA_LINE = re.compile(r"([0-9a-f]{64})  ([0-9]+)  ([!-~]+)\n\Z")
